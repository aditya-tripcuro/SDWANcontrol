# ── Core ──────────────────────────────────────────────────────────────────────

# Absolute path to config.yaml
# Default: /etc/wancontrol/config.yaml
WANCONTROL_CONFIG=/etc/wancontrol/config.yaml

# ── Database ──────────────────────────────────────────────────────────────────

# Absolute path to the SQLite database file.
# Overrides db_path in config.yaml if set.
# Default: /var/lib/wancontrol/wan.db
WANCONTROL_DB_PATH=/var/lib/wancontrol/wan.db

# ── Server ────────────────────────────────────────────────────────────────────

# Secret key for JWT signing and Flask sessions.
# Must be at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# This overrides server.secret_key in config.yaml.
WANCONTROL_SECRET_KEY=REPLACE_ME_run_python_secrets_token_hex_32

# Flask/gunicorn bind host
# Default: 0.0.0.0
WANCONTROL_HOST=0.0.0.0

# Flask/gunicorn bind port
# Default: 5000
WANCONTROL_PORT=5000

# ── Logging ───────────────────────────────────────────────────────────────────

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
WANCONTROL_LOG_LEVEL=INFO

# Absolute path to log directory.
# Overrides log_dir in config.yaml if set.
# Default: /var/lib/wancontrol/logs
WANCONTROL_LOG_DIR=/var/lib/wancontrol/logs

# ── Development ───────────────────────────────────────────────────────────────

# Set to 1 to skip all real network/subprocess calls (safe for dev on Windows/WSL).
# All network.py functions return success without touching the system.
# Default: 0
WANCONTROL_DRY_RUN=0

# Set to 1 to enable Flask debug mode and verbose SQL logging.
# NEVER set this in production.
# Default: 0
WANCONTROL_DEBUG=0
